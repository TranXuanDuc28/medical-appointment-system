# AI Service – biến môi trường (tất cả đều tuỳ chọn)
# Cổng chạy dịch vụ HTTP
AI_PORT=8001
# Token dùng chung giữa backend Node và AI Service. Đặt giá trị => mọi request /predict-*, /triage phải gửi header X-AI-Token.
AI_SERVICE_TOKEN=
# Đường dẫn file Kaggle (mặc định: data/raw/ hoặc thư mục gốc dự án)
AI_KAGGLE_CSV=
# Kết nối MySQL để xuất dữ liệu thật tái huấn luyện (npm run ... / python -m ai_service export-real)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE_NAME=webhealthcare_v2
