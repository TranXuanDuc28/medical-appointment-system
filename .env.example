# Cấu hình tuỳ chọn cho `docker compose up`. Copy thành .env để đổi; KHÔNG commit file .env.
# Bỏ trống/không có file này: dùng giá trị DEMO mặc định trong docker-compose.yml.

# --- Cổng mở ra máy chủ ---
WEB_PORT=3000
API_PORT=6969
MYSQL_PORT=3307

# --- Địa chỉ theo tên miền khi triển khai (đổi PUBLIC_API_URL thì phải build lại web) ---
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:6969

# --- Môi trường: demo (mặc định) | production (cần HTTPS + CORS đúng) ---
APP_ENV=demo

# --- Cơ sở dữ liệu ---
DB_NAME=clinic_queue
DB_USER=clinic
DB_PASSWORD=demo_clinic_pw
DB_ROOT_PASSWORD=demo_root_pw

# --- Bí mật: ĐỔI khi triển khai thật (JWT >= 32 ký tự, hai giá trị khác nhau) ---
JWT_SECRET=demo-jwt-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=demo-refresh-secret-change-me-fedcba9876543210
AI_SERVICE_TOKEN=demo-ai-token

# --- Dữ liệu demo ---
SEED_DEMO=true
DEMO_PASSWORD=Demo@12345

# --- Tuỳ chọn: bỏ trống thì tính năng tương ứng tự tắt ---
EMAIL_APP=
EMAIL_APP_PASSWORD=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_FACEBOOK_APP_ID=
